<Window x:Class="AIAgent.UI.DialogUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AIAgent.UI"
        mc:Ignorable="d" 
        d:DesignHeight="450" d:DesignWidth="800"
        Title="AI Assistant" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:UserBackgroundConverter x:Key="UserBackgroundConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Name="scroll" CanContentScroll="True"  Grid.Row="0" Margin="0,0,0,10" Height="Auto">
            <!-- Список сообщений -->
            <ListBox x:Name="lstMessages"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Background="#F5F5F5" BorderThickness="1" BorderBrush="#CCC"
                 ItemsSource="{Binding Messages}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4" Padding="8" CornerRadius="8"
                    Background="{Binding IsUser, Converter={StaticResource UserBackgroundConverter}}">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
        

        <!-- Индикатор загрузки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar Width="150" Height="15" IsIndeterminate="True" Margin="0,0,10,0"/>
            <TextBlock Text="Печатает..." FontStyle="Italic" VerticalAlignment="Center"/>
            <Button Content="Отмена" Margin="10,0,0,0" Padding="8,2" Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Панель ввода -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtInput" Grid.Column="0" Margin="0,0,10,0"
                     FontSize="14" VerticalContentAlignment="Center"
                     KeyDown="txtInput_KeyDown" AcceptsReturn="True"
                     MinHeight="30" TextWrapping="Wrap"/>
            <Button x:Name="btnSend" Grid.Column="1" Content="Отправить"
                    Click="btnSend_Click" Padding="15,8" FontSize="14"
                    IsDefault="True" IsEnabled="{Binding IsNotBusy}"/>
        </Grid>
    </Grid>
</Window>