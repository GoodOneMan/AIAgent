<Window x:Class="AIAgent.UI.DialogUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIAgent.UI"
        Title="AI Assistant" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:UserBackgroundConverter x:Key="UserBackgroundConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="lstMessages" ItemsSource="{Binding Messages}"
                 Grid.Row="0" Margin="0,0,0,10"
                 Background="#F5F5F5" BorderThickness="1" BorderBrush="#CCC"
                 ScrollViewer.CanContentScroll="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizationMode="Recycling"
                                    IsVirtualizing="True"
                                    ScrollUnit="Pixel" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4" Padding="8" CornerRadius="8"
                        Background="{Binding IsUser, Converter={StaticResource UserBackgroundConverter}}">
                        <TextBox Text="{Binding Text}" 
                             TextWrapping="Wrap" 
                             FontSize="14"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             CaretBrush="Transparent"
                             FocusVisualStyle="{x:Null}"
                             IsTabStop="False"
                             Cursor="IBeam" />
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <!--<ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4" Padding="8" CornerRadius="8"
                            Background="{Binding IsUser, Converter={StaticResource UserBackgroundConverter}}">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" 
                                   FontSize="14"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>-->
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar Width="150" Height="15" IsIndeterminate="True" Margin="0,0,10,0"/>
            <TextBlock Text="Печатает..." FontStyle="Italic" VerticalAlignment="Center"/>
            <Button Content="Отмена" Margin="10,0,0,0" Padding="8,2" Command="{Binding CancelCommand}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Кнопка загрузки модели -->
            <Button Grid.Column="0" Content="📂 Загрузить модель"
            Command="{Binding LoadModelCommand}"
            Padding="10,8" Margin="0,0,10,0"
            FontSize="14"
            IsEnabled="{Binding IsNotBusy}"
            ToolTip="Извлечь геометрию и свойства выделенных элементов"/>

            <TextBox x:Name="txtInput" Grid.Column="1" Margin="0,0,10,0"
             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             FontSize="14" VerticalContentAlignment="Center"
             KeyDown="txtInput_KeyDown" AcceptsReturn="True"
             MaxHeight="90" TextWrapping="Wrap"
             IsEnabled="{Binding IsNotBusy}"/>

            <Button Grid.Column="2" Content="Отправить"
            Command="{Binding SendCommand}"
            Padding="15,8" FontSize="14" IsDefault="True"
            IsEnabled="{Binding IsNotBusy}"/>
        </Grid>
    </Grid>
</Window>